# Copy to .env for local dev. On Railway these are set in the service Variables.

# Postgres connection string. Railway injects DATABASE_URL when you add a Postgres plugin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/valor?schema=public"

# HTTP
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Auth — 32+ chars required; generate random strings (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET="dev-access-secret-change-me-0000000000"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-0000000000"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated origins, or * for any (dev only)
CORS_ORIGINS="*"

# Public base used to build absolute upload URLs (no trailing slash)
PUBLIC_BASE_URL="http://localhost:8080"

# Official-data ingestion (optional — only needed to run `npm run ingest`).
# NPS: free instant key at https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=""
# VA Lighthouse Facilities API key: https://developer.va.gov/explore/api/va-facilities
VA_API_KEY=""
# Optional preferred Overpass endpoint for OSM discount ingestion (no key needed)
# OVERPASS_BASE="https://overpass-api.de/api/interpreter"
